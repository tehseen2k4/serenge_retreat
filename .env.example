# ==============================================================
# Serengé Retreat - Environment Configuration Template
# ==============================================================

# 1. OpenRouter AI Gateway (https://openrouter.ai)
# Obtain your key from OpenRouter Dashboard > Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct

# 2. Meta WhatsApp Cloud API (https://developers.facebook.com)
# The permanent System User access token with 'whatsapp_business_messaging' permission
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token_here

# The Phone Number ID assigned by Meta in the WhatsApp > API Setup section
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# Custom secret string you create and enter in the Meta Webhook configuration
WHATSAPP_VERIFY_TOKEN=your_custom_secret_verify_token_here

# App Secret found in Meta App Dashboard > App Settings > Basic (used for HMAC signature validation)
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# 3. Existing Integrations (Already in your project)
RESEND_API_KEY=your_resend_api_key_here
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
HUBSPOT_ACCESS_TOKEN=your_hubspot_token_here
